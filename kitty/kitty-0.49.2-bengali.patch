+static bool
+is_bengali_cell(const CPUCell *c, const TextCache *tc) {
+    const char_type ch = cell_first_char(c, tc);
+    return ch >= 0x0980 && ch <= 0x09FF;
+}
+
+static bool
+is_bengali_group(const Group *g, const TextCache *tc) {
+    return is_bengali_cell(G(first_cpu_cell) + g->first_cell_idx, tc);
+}
+
+// HarfBuzz clusters Bengali by syllable, so a phrase arrives as many groups. Merge each
+// run of Bengali groups, including the single spaces render_line() keeps inside Bengali
+// runs, into one group, so the phrase is drawn with natural shaping and spacing and
+// fitted into its cells as a unit, instead of each syllable spaced out in its own cells.
+static void
+merge_bengali_word_groups(const TextCache *tc) {
+    if (!bengali_mode() || !G(group_idx)) return;
+    size_t out = 0;
+    for (size_t i = 1; i <= G(group_idx); i++) {
+        Group *a = G(groups) + out, *b = G(groups) + i;
+        if (a->num_cells && b->num_cells && a->num_cells + b->num_cells <= 96 &&
+            a->first_cell_idx + a->num_cells == b->first_cell_idx &&
+            a->first_glyph_idx + a->num_glyphs == b->first_glyph_idx &&
+            is_bengali_group(a, tc) &&
+            (is_bengali_group(b, tc) || cell_first_char(G(first_cpu_cell) + b->first_cell_idx, tc) == ' ')) {
+            a->num_cells += b->num_cells;
+            a->num_glyphs += b->num_glyphs;
+            a->has_special_glyph |= b->has_special_glyph;
+        } else G(groups)[++out] = *b;
+    }
+    G(group_idx) = out;
+}

 static char_type
 ensure_char_in_range(const char_type value) {
@@ -17,10 +19,48 @@ ensure_char_in_range(const char_type value) {
     return value & mask;
 }
 
+// Bengali characters glibc's wcwidth() gives width 1 (every assigned one except the
+// seven non-spacing marks). In "glibc" mode each of these gets its own cell, exactly
+// like zsh, bash, tmux, coreutils and less count them, so no application needs changes.
+static bool
+is_bengali_glibc_spacing(char_type ch) {
+    return ch == 0x0980 || ch == 0x0982 || ch == 0x0983 || (ch >= 0x0985 && ch <= 0x098C) ||
+           ch == 0x098F || ch == 0x0990 || (ch >= 0x0993 && ch <= 0x09A8) || (ch >= 0x09AA && ch <= 0x09B0) ||
+           ch == 0x09B2 || (ch >= 0x09B6 && ch <= 0x09B9) || (ch >= 0x09BD && ch <= 0x09C0) ||
+           ch == 0x09C7 || ch == 0x09C8 || ch == 0x09CB || ch == 0x09CC || ch == 0x09CE || ch == 0x09D7 ||
+           ch == 0x09DC || ch == 0x09DD || (ch >= 0x09DF && ch <= 0x09E1) || (ch >= 0x09E6 && ch <= 0x09FD);
+}
+
+// ponytail: opt-in via env var KITTY_BENGALI=glibc; a kitty.conf option is the upgrade path.
+bool
+bengali_mode(void) {
+    static int mode = -1;
+    if (mode < 0) {
+        const char *v = getenv("KITTY_BENGALI");
+        mode = v && strcmp(v, "glibc") == 0;
+    }
+    return mode;
+}
+
+// Vowel signs and marks JS (Bun) counts as 0 cells but glibc as 1. After a ZWJ they
+// join the previous cell, as tmux does: bangla-term's Claude Code proxy marks them so.
+bool
+bengali_zwj_joins(char_type ch) {
+    return ch == 0x0980 || ch == 0x0982 || (ch >= 0x09BE && ch <= 0x09C0) || ch == 0x09C7 ||
+           ch == 0x09C8 || ch == 0x09CB || ch == 0x09CC || ch == 0x09D7;
+}
+
 CharProps
 char_props_for(char_type ch) {
     ch = ensure_char_in_range(ch);
-    return CharProps_t3[CharProps_t2[(CharProps_t1[ch >> CharProps_shift] << CharProps_shift) + (ch & CharProps_mask)]];
+    CharProps ans = CharProps_t3[CharProps_t2[(CharProps_t1[ch >> CharProps_shift] << CharProps_shift) + (ch & CharProps_mask)]];
+    if (UNLIKELY(ch >= 0x0980 && ch <= 0x09FE) && is_bengali_glibc_spacing(ch) && bengali_mode()) {
+        // its own 1-cell character: no spacing-mark or conjunct (GB9c) joining
+        ans.shifted_width = 1 + 4 /*=width_shift*/;
+        ans.grapheme_break = GBP_None;
+        ans.indic_conjunct_break = 0;
+    }
+    return ans;
 }
 

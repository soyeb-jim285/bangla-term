+// Area-average columns [src_left, src_right) of src into exactly dest_width columns of dest.
+static void
+fit_canvas_horizontally(
+    const pixel *src, unsigned src_stride, unsigned src_left, unsigned src_right, pixel *dest, unsigned dest_width, unsigned height) {
+    const float ratio = (float)(src_right - src_left) / (float)dest_width;
+    for (unsigned y = 0; y < height; y++) {
+        const pixel *srow = src + y * src_stride;
+        pixel *drow = dest + y * dest_width;
+        for (unsigned x = 0; x < dest_width; x++) {
+            const float start = src_left + x * ratio, end = start + ratio;
+            float acc[4] = {0};
+            for (unsigned sx = (unsigned)start; (float)sx < end && sx < src_right; sx++) {
+                const float w = MIN(end, sx + 1.f) - MAX(start, (float)sx);
+                for (unsigned c = 0; c < 4; c++) acc[c] += w * (float)((srow[sx] >> (8 * c)) & 0xff);
+            }
+            pixel p = 0;
+            for (unsigned c = 0; c < 4; c++) p |= (pixel)MIN(255.f, roundf(acc[c] / ratio)) << (8 * c);
+            drow[x] = p;
+        }
+    }
+}

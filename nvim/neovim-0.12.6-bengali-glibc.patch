 {
-  return (!utf8proc_grapheme_break_stateful(c1, c2, state)
+  return ((!utf8proc_grapheme_break_stateful(c1, c2, state) && !bengali_glibc_char(c2))
           || arabic_combine(c1, c2));
 }
 
